# iOS delivery to TestFlight, run on a Mac (see docs/release.md).
#
# Signing is cloud-managed: Xcode asks App Store Connect to sign, authenticated by the API key, so
# there is no `match` repository and no certificate in this tree. Credentials come from the
# environment only; nothing secret is written here.

require_relative "../../fastlane/slack"

default_platform(:ios)

ENVS = %w[dev prod].freeze
LANES_NOTIFIED = %i[build beta].freeze

before_all do |lane, options|
  next unless LANES_NOTIFIED.include?(lane)

  SlackNotify.started("iOS", lane, resolve_env(options))
end

after_all do |lane, options|
  next unless LANES_NOTIFIED.include?(lane)

  SlackNotify.succeeded("iOS", lane, resolve_env(options))
end

error do |lane, exception, options|
  next unless LANES_NOTIFIED.include?(lane)

  SlackNotify.failed("iOS", lane, resolve_env(options), exception.message)
end

platform :ios do
  desc "Build a signed App Store archive without uploading it. `env:dev` (default) or `env:prod`"
  lane :build do |options|
    archive(next_build_number(api_key))
  end

  desc "Build and upload to TestFlight for internal testers. `env:dev` (default) or `env:prod`"
  lane :beta do |options|
    key = api_key
    archive(next_build_number(key))
    upload_to_testflight(
      api_key: key,
      # Internal testers only; external testing goes through Beta App Review.
      distribute_external: false,
      skip_waiting_for_build_processing: true,
    )
  end
end

# Defaults to dev: the environment where a mistaken run costs least.
def resolve_env(options)
  name = (options && options[:env] || "dev").to_s
  ENVS.include?(name) ? name : UI.user_error!("Unknown env '#{name}'. Use one of: #{ENVS.join(', ')}")
end

# The App Store Connect API key. It must be a Team key: an Individual key cannot provision.
def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
  )
end

# The store decides the next build number, so two machines can ship without coordinating.
def next_build_number(key)
  latest_testflight_build_number(
    api_key: key,
    app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
    initial_build_number: 0, # nothing uploaded yet -> start at 1
  ) + 1
end

def archive(build_number)
  app_dir = File.expand_path("../..", __dir__)
  flutter = ENV.fetch("FLUTTER", "flutter")
  defines = ENV.fetch("DEFINES", "")

  # Lets Flutter write the build settings (version, build number, defines) the archive reads.
  sh("cd #{app_dir} && #{flutter} build ios --release --config-only --no-codesign " \
     "--build-number #{build_number} #{defines}")

  # xcodebuild wants the key as a file, so the content is written to a temp file for this run only.
  key_file = Tempfile.new(["asc_key", ".p8"])
  key_file.write(ENV.fetch("ASC_KEY_CONTENT"))
  key_file.close

  build_app(
    workspace: File.join(app_dir, "ios", "Runner.xcworkspace"),
    scheme: "Runner",
    configuration: "Release",
    export_method: "app-store",
    output_directory: File.join(app_dir, "build", "ios", "fastlane"),
    clean: true,
    export_options: { signingStyle: "automatic" },
    # gym does not forward the API key to xcodebuild, so cloud signing needs the flags spelled out.
    xcargs: [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_file.path,
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID"),
      "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
    ].join(" "),
  )
ensure
  key_file&.unlink
end
